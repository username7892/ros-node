<?xml version="1.0"?>
<package format="2">
  <name>m20_yolo</name>
  <version>0.3.0</version>
  <description>M20 YOLO inference node (Python/rclpy). Subscribes to /m20/image_raw and /m20/detect_targets, runs YOLOE(.pt) inference, draws boxes with OpenCV, publishes /m20/image_detected at a fixed 10Hz.</description>

  <maintainer email="wxh@todo.todo">wxh</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>m20_msgs</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>m20_msgs</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>m20_msgs</exec_depend>

  <export>
  </export>
</package>
