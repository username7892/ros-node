<?xml version="1.0"?>
<launch>
  <!-- M20 检测链路: 视频(拉流+硬解) / YOLOE 推理 / 推流(H264 RTSP 给 MediaMTX 转 WebRTC)
       参数按节点拆分在 config/*.yaml, 每个文件内容直接就是该节点的私有参数。 -->

  <arg name="cfg_dir" default="$(find m20_yolo)/config"/>

  <!-- 视频节点: RTSP 拉流 + NVDEC 硬解 -->
  <node pkg="m20_camera" type="video_node" name="m20_video_node" output="screen">
    <rosparam file="$(arg cfg_dir)/video_node.yaml" command="load"/>
  </node>

  <!-- server: Service 收目标 + Topic 广播 -->
  <node pkg="m20_server" type="server_node" name="m20_server_node" output="screen">
    <rosparam file="$(arg cfg_dir)/server_node.yaml" command="load"/>
  </node>

  <!-- yolo: YOLOE 推理, 固定帧率输出 -->
  <node pkg="m20_yolo" type="yolo_node.py" name="m20_yolo_node" output="screen"
        launch-prefix="/home/wxh/venv/dog_det/bin/python">
    <rosparam file="$(arg cfg_dir)/yolo_node.yaml" command="load"/>
  </node>

  <!-- stream: 画框结果编码 H264 推给 MediaMTX -->
  <node pkg="m20_yolo" type="stream_node.py" name="m20_stream_node" output="screen">
    <rosparam file="$(arg cfg_dir)/stream_node.yaml" command="load"/>
  </node>

  <!-- client: 启动时下发一次检测目标 -->
  <node pkg="m20_client" type="client_node" name="m20_client_node" output="screen">
    <rosparam file="$(arg cfg_dir)/client_node.yaml" command="load"/>
  </node>
</launch>
